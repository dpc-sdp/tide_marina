{
  "name": "dpc-sdp/tide_marina",
  "description": "Drupal integrations and dependency management for the Tide Marina.",
  "type": "drupal-module",
  "license": "GPL-2.0-or-later",
  "require": {
    "drupal/purge_purger_http": "^1.3",
    "ext-pdo_mysql": "*",
    "ext-gd": "*",
    "ext-igbinary": "*",
    "ext-redis": "*",
    "ext-zip": "*",
    "ext-zlib": "*"
  },
  "extra": {
    "composer-exit-on-patch-failure": true,
    "enable-patching": true
  },
  "repositories": {
    "drupal": {
      "type": "composer",
      "url": "https://packages.drupal.org/8"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
