<?php

/**
 * @file
 * Installs and uninstalls the Marina CloudFront cache tags integration.
 */

/**
 * Implements hook_install().
 */
function marina_cf_cachetags_install() {
  marina_cf_cachetags_configure_purge();
}

/**
 * Configure the purger, queuer, and processor used by the integration.
 */
function marina_cf_cachetags_configure_purge() {
  $config = \Drupal::configFactory()->getEditable('purge.plugins');

  // Register the purger that sends tags to the sidecar. It is the HTTP bundled
  // purger with a cap on attempts, and uses the same instance settings.
  $purgers = $config->get('purgers') ?? [];
  $purger_exists = FALSE;
  foreach ($purgers as &$purger) {
    if (($purger['instance_id'] ?? NULL) === 'marina_cf_cachetags') {
      $purger['plugin_id'] = 'marina_cf_cachetags';
      $purger_exists = TRUE;
      break;
    }
  }
  unset($purger);
  if (empty($purger_exists)) {
    $purgers[] = [
      'order_index' => 3,
      'instance_id' => 'marina_cf_cachetags',
      'plugin_id' => 'marina_cf_cachetags',
    ];
  }
  $config->set('purgers', $purgers);

  // Queue cache tags invalidated by Drupal core and contributed modules.
  $queuers = $config->get('queuers') ?? [];
  $coretags_exists = FALSE;
  foreach ($queuers as &$queuer) {
    if (($queuer['plugin_id'] ?? NULL) === 'coretags') {
      $queuer['status'] = TRUE;
      $coretags_exists = TRUE;
      break;
    }
  }
  unset($queuer);
  if (empty($coretags_exists)) {
    $queuers[] = [
      'plugin_id' => 'coretags',
      'status' => TRUE,
    ];
  }
  $config->set('queuers', $queuers);

  // Process pending invalidations after the response has been sent, at most
  // once per interval, instead of Purge's lateruntime processor, which sends
  // on every request. The cron processor picks up anything left on sites
  // with no further traffic.
  $enabled = [
    'marina_cf_cachetags_lateruntime' => TRUE,
    'cron' => TRUE,
    'lateruntime' => FALSE,
  ];
  $processors = $config->get('processors') ?? [];
  foreach ($processors as &$processor) {
    $plugin_id = $processor['plugin_id'] ?? NULL;
    if (isset($enabled[$plugin_id])) {
      $processor['status'] = $enabled[$plugin_id];
      unset($enabled[$plugin_id]);
    }
  }
  unset($processor);
  foreach ($enabled as $plugin_id => $status) {
    if ($status) {
      $processors[] = [
        'plugin_id' => $plugin_id,
        'status' => TRUE,
      ];
    }
  }
  $config->set('processors', $processors)->save();

  // Log failures from the purger. The channel is named after the plugin, so
  // replace the one used when the instance ran on the plain HTTP bundled
  // purger. Use the logger service: it writes its own copy of the channels
  // back to config when it is destroyed, which would undo a direct edit.
  $purge_logger = \Drupal::service('purge.logger');
  $purge_logger->deleteChannel('purger_httpbundled_marina_cf_cachetags');
  $purge_logger->setChannel('purger_marina_cf_cachetags_marina_cf_cachetags', [0, 2, 3]);
}

/**
 * Install the correctly named HTTP purger config on existing sites.
 */
function marina_cf_cachetags_update_10001() {
  $config_factory = \Drupal::configFactory();
  $config_name = 'purge_purger_http.settings.marina_cf_cachetags';

  if ($config_factory->get($config_name)->isNew()) {
    \Drupal::service('config.installer')
      ->installDefaultConfig('module', 'marina_cf_cachetags');
  }

  marina_cf_cachetags_configure_purge();
}

/**
 * Cap purge attempts and allow the invalidation API 5 seconds to respond.
 */
function marina_cf_cachetags_update_10002() {
  marina_cf_cachetags_configure_purge();

  $settings = \Drupal::configFactory()
    ->getEditable('purge_purger_http.settings.marina_cf_cachetags');
  if (!$settings->isNew() && (float) $settings->get('timeout') < 5.0) {
    $settings->set('timeout', 5.0)->save();
  }
}

/**
 * Implements hook_uninstall().
 */
function marina_cf_cachetags_uninstall() {
  $config_factory = \Drupal::configFactory();
  $config = $config_factory->getEditable('purge.plugins');
  $purgers = $config->get('purgers') ?? [];

  // Avoid leaving Purge with a reference to this module's deleted settings.
  $purgers = array_values(array_filter($purgers, static function (array $purger) {
    return ($purger['instance_id'] ?? NULL) !== 'marina_cf_cachetags';
  }));

  $config->set('purgers', $purgers)->save();

  $purge_logger = \Drupal::service('purge.logger');
  $purge_logger->deleteChannel('purger_marina_cf_cachetags_marina_cf_cachetags');
  $purge_logger->deleteChannel('purger_httpbundled_marina_cf_cachetags');
}

/**
 * Process invalidations at most once a minute instead of on every request.
 */
function marina_cf_cachetags_update_10003() {
  if (!\Drupal::moduleHandler()->moduleExists('purge_processor_cron')) {
    \Drupal::service('module_installer')->install(['purge_processor_cron']);
  }

  marina_cf_cachetags_configure_purge();
}
